<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>

    <Authors>João Pedro Schio Ortega</Authors>
    <RepositoryUrl>https://github.com/Joao-Schio/OrtegaLibDotNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Joao-Schio/OrtegaLibDotNet</PackageProjectUrl>
    <PackageTags>ortegalib;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
